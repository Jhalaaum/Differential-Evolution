
%%
clc;
clear all;

format long;
format compact;
tic;

% problem set of 18 benchmark functions to be tested
problemSet=1:18;

% the number of dimensions which can be set as 10 or 30
n=30;

% the size of evolving population
if n==10
    popsize=35;
elseif n==30
    popsize=60;
end

% the maximum number of function evaluations
if n==10
    totalFES=200000;
elseif n==30
    totalFES=600000;
end

    
% the value which represents the number of total runs
totalTime=25;


global gen maxGen VAR

maxGen=ceil(totalFES/(popsize*3));

% choose the function to be tested
for problemIndex = 1:18
    problem = problemSet(problemIndex)
    
    % the value used to record the number of runs
    time=1;
    
    while time <= totalTime
        switch problem
            
            case 1  % each case represents a different benchmark function
                
                % the lower boundary of the tested function
                minVar=zeros(1,n);
                
                % the upper boundary of the tested function
                maxVar=10*ones(1,n);
                
            case 2
                
                minVar=-5.12*ones(1,n);
                maxVar=5.12*ones(1,n);
                
            case 3
                
                minVar=-1000*ones(1,n);
                maxVar=1000*ones(1,n);
                
            case 4
                
                minVar=-50*ones(1,n);
                maxVar=50*ones(1,n);
                
            case 5
                
                minVar=-600*ones(1,n);
                maxVar=600*ones(1,n);
                
            case 6
                
                minVar=-600*ones(1,n);
                maxVar=600*ones(1,n);
                
            case 7
                
                minVar=-140*ones(1,n);
                maxVar=140*ones(1,n);
                
            case 8
                
                minVar=-140*ones(1,n);
                maxVar=140*ones(1,n);
                
            case 9
                
                minVar=-500*ones(1,n);
                maxVar=500*ones(1,n);
                
            case 10
                
                minVar=-500*ones(1,n);
                maxVar=500*ones(1,n);
                
            case 11
                
                minVar=-100*ones(1,n);
                maxVar=100*ones(1,n);
                
            case 12
                
                minVar=-1000*ones(1,n);
                maxVar=1000*ones(1,n);
            case 13
                
                minVar=-500*ones(1,n);
                maxVar=500*ones(1,n);
                
            case 14
                
                minVar=-1000*ones(1,n);
                maxVar=1000*ones(1,n);
                
            case 15
                
                minVar=-1000*ones(1,n);
                maxVar=1000*ones(1,n);
                
            case 16
                
                minVar=-10*ones(1,n);
                maxVar=10*ones(1,n);
                
            case 17
                
                minVar=-10*ones(1,n);
                maxVar=10*ones(1,n);
                
            case 18
                
                minVar=-50*ones(1,n);
                maxVar=50*ones(1,n);
        end
        
        rng(problemIndex)
        
        % initialize the population
        p=repmat(minVar,popsize,1)+rand(popsize,n).*repmat((maxVar-minVar),popsize,1);
        
        % Evaluate the population
        [objF, conV]=fitness(p, problem);
        FES=popsize;
        
        
        gen=1;    X=0;
        
        VAR0=max(conV);         
               
        while FES<=totalFES
            
            cp=(-log(VAR0)-6)/log(1-0.5);
            % adjust the threshold
            if X < 0.5
                VAR=VAR0*(1-X)^cp;
            else
                VAR=0;
            end

            % the restart strategy
            [p,objF,conV,FES]=diversity(p,objF,conV,minVar,maxVar,problem,FES);
         
            % generate the next generation
             temp=DEgenerator(p,objF,conV,minVar,maxVar);
             [objFtemp,conVtemp]=fitness(temp,problem);
             FES=FES+popsize*3;
            
             % preselection by the feasibility rule
            [trial, objFtrial, conVtrial]=preSelect(temp,objFtemp,conVtemp);
            
            % slecting next generation by the epsilon constraint-handling
            % technique
            [p,objF,conV]=epsSelect(p,objF,conV,trial,objFtrial,conVtrial);    
                                   
            gen=gen+1;
            X=X+1/maxGen;
                        
        end
        
        % modify the value of "time"
        time=time+1;
        
        % calculate the best solution of each run
        % calculate the index of feasible solutions
        feasiIndex=find(conV==0);
        
        if ~isempty(feasiIndex)
            
            % sort the feasible solutions according to their objective
            % function values
            [sortedFeasiVec,~]=sort(objF(feasiIndex));
            
            % the best solution is the feasible solution with minimum
            % objective function value
            bestSolution=sortedFeasiVec(1);
            
        else
            
            % if the population is infeasible, the best solution is
            % assigned the value of NaN
            bestSolution=NaN;
            
            
        end

        [bestSolution]
        
    end

end
run_time = toc